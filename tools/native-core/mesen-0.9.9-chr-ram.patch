+uint32_t BaseMapper::TestChrRamAddressClassification()
+{
+    class Probe : public BaseMapper {
+        void InitMapper() override {}
+        uint16_t GetPRGPageSize() override { return 0x4000; }
+        uint16_t GetCHRPageSize() override { return 0x2000; }
+    public:
+        Probe() {
+            _chrRamSize = _chrRomSize = 0x2000;
+            _chrRam = new uint8_t[_chrRamSize];
+            // A zero-length CHR-ROM allocation can sit within 8K of live RAM.
+            // Force overlap deterministically instead of relying on the heap.
+            _chrRom = _chrRam;
+            SetPpuMemoryMapping(0, 0x1fff, _chrRam, MemoryAccessType::ReadWrite);
+        }
+        ~Probe() { _chrRom = nullptr; }
+    };
+    Probe mapper;
+    mapper._onlyChrRam = true;
+    uint32_t checks = 0;
+    for(uint16_t address = 0; address < 0x2000; address++) {
+        PpuAddressTypeInfo info;
+        mapper.GetPpuAbsoluteAddressAndType(address, &info);
+        if(info.Type != PpuAddressType::ChrRam || info.Address != address) return checks;
+        checks++;
+        if(mapper.ToAbsoluteChrAddress(address) != address) return checks;
+        checks++;
+        if(mapper.ToAbsoluteChrRomAddress(address) != -1) return checks;
+        checks++;
+    }
+    return checks;
+}
